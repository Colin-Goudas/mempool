{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "buildCommand": "node build-pending-tracker.js",
  "outputDirectory": "dist/mempool/browser",
  "routes": [
    {
      "src": "/mempool/api/(.*)",
      "dest": "https://mempool.space/api/$1"
    },
    {
      "src": "/api/explain",
      "status": 404
    },
    {
      "src": "/api/(.*)",
      "dest": "https://mempool.space/api/$1"
    },
    {
      "src": "/(?:mempool/)?resources/mining-pools/(.*)",
      "dest": "https://mempool.space/resources/mining-pools/$1"
    },
    {
      "src": "/(?:ethereum|eth|faq)(?:/.*)?",
      "dest": "/retired.html",
      "status": 410
    },
    {
      "src": "/(?:mempool/)?welcome/?",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "/mempool/?",
      "headers": {
        "Location": "/bitcoin"
      },
      "status": 308
    },
    {
      "src": "/btc/(.*)",
      "headers": {
        "Location": "/tx/$1"
      },
      "status": 308
    },
    {
      "src": "/wallet/(.*)",
      "headers": {
        "Location": "/address/$1"
      },
      "status": 308
    },
    {
      "src": "/mempool/(.*)",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
